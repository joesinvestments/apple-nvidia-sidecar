diff --git a/b/tinygrad/runtime/support/apl_direct.py b/tinygrad/runtime/support/apl_direct.py
new file mode 100644
index 0000000..811306a
--- /dev/null
+++ b/tinygrad/runtime/support/apl_direct.py
@@ -0,0 +1,136 @@
+"""APLDirectPCIDevice: tinygrad talks to our dext in-process through libtgd.
+
+The GPU sits behind Thunderbolt/USB4 on a Mac Studio, so there is no /sys bus to scan: libtgd reaches the
+card through the dext directly. Set APL_DIRECT=1 to make System.list_devices return this device instead of
+the socket client (system.py reads the env var at call time, nothing is patched at import time).
+
+  APL_DIRECT=1 TGD_LIB=/path/libtgd.dylib <your script>
+"""
+from __future__ import annotations
+import ctypes, functools, os, struct
+from tinygrad.helpers import getenv, ceildiv, round_up
+from tinygrad.runtime.support.system import RemotePCIDevice
+from tinygrad.runtime.support.memory import MMIOInterface
+
+MAX_PAIRS = 64  # dext caps a DMA at 32 segments (TinyGPUDriver.cpp:145) plus the [0, 0] terminator
+
+@functools.cache
+def tgd() -> ctypes.CDLL:
+  lib = ctypes.CDLL(getenv("TGD_LIB", "libtgd.dylib"))
+  u32, u64, vp, i = ctypes.c_uint32, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int
+  for name, res, args in [("tgd_open", i, []), ("tgd_map_bar", vp, [i, i, ctypes.POINTER(u64)]),
+                          ("tgd_dma_alloc", vp, [u64, ctypes.POINTER(u64), u32, ctypes.POINTER(u64)]),
+                          ("tgd_dma_free", i, [u64, vp, u64]), ("tgd_mmio_copy", None, [vp, vp, u64]),
+                          ("tgd_cfg_read", i, [u32, u32, ctypes.POINTER(u32)]), ("tgd_cfg_write", i, [u32, u32, u32]),
+                          ("tgd_reset", i, []), ("tgd_spin_ge", u32, [vp, u32, u64]), ("tgd_land", None, [vp, u32])]:
+    fn = getattr(lib, name)
+    fn.restype, fn.argtypes = res, args
+  if hasattr(lib, "tgd_dma_register"):  # older libtgd builds do not have it
+    lib.tgd_dma_register.restype, lib.tgd_dma_register.argtypes = i, [vp, u64, ctypes.POINTER(u64), u32, ctypes.POINTER(u64)]
+    lib.tgd_dma_unregister.restype, lib.tgd_dma_unregister.argtypes = i, [u64]
+  return lib
+
+class DirectMMIOInterface(MMIOInterface):
+  """A BAR pointer in this process. Slices go through tgd_mmio_copy: aligned 32-bit or byte accesses only, so
+  Device memory never sees an unaligned or 16-byte access . Same return types as RemoteMMIOInterface:
+  bytes for fmt 'B' slices, lists otherwise. Scalars use the memoryview."""
+  def _span(self, k) -> tuple[int, int]:
+    if not isinstance(k, slice): return k, 1
+    start, stop, step = k.indices(len(self))
+    assert step == 1, "strided MMIO access is not supported"
+    return start, max(0, stop - start)
+
+  def __getitem__(self, k):
+    if not isinstance(k, slice): return self.mv[k]
+    start, cnt = self._span(k)
+    el = struct.calcsize(self.fmt)
+    buf = ctypes.create_string_buffer(cnt * el)
+    tgd().tgd_mmio_copy(buf, self.addr + start * el, cnt * el)
+    return buf.raw if self.fmt == 'B' else list(struct.unpack(f'<{cnt}{self.fmt}', buf.raw))
+
+  def __setitem__(self, k, v):
+    if not isinstance(k, slice):
+      self.mv[k] = v
+      return
+    start, cnt = self._span(k)
+    el = struct.calcsize(self.fmt)
+    if self.fmt == 'B' or not isinstance(v, (list, tuple)): data = bytes(v)
+    else: data = struct.pack(f'<{len(v)}{self.fmt}', *v)
+    assert len(data) == cnt * el, f"MMIO write of {len(data)} bytes into a {cnt * el} byte slice"
+    tgd().tgd_mmio_copy(self.addr + start * el, data, len(data))
+
+  def view(self, offset:int=0, size:int|None=None, fmt=None) -> DirectMMIOInterface:
+    return DirectMMIOInterface(self.addr+offset, (self.nbytes - offset) if size is None else size, fmt=fmt or self.fmt)
+
+class APLDirectPCIDevice(RemotePCIDevice):
+  """Subclasses RemotePCIDevice on purpose: PCIIfaceBase then treats it as remote, so the Linux-only VA
+  reservation and the sysmem munmap stay off, exactly as for the socket client. Overrides every method that
+  would touch the socket."""
+  @staticmethod
+  def scan(vendor:int, devices:tuple[tuple[int, tuple[int, ...]], ...], base_class:int|None) -> list[tuple]:
+    if (rc:=tgd().tgd_open()) != 0: return []
+    cfg = ctypes.c_uint32()
+    if tgd().tgd_cfg_read(0, 4, ctypes.byref(cfg)) != 0: return []
+    dword = cfg.value
+    if dword & 0xffff != vendor: return []
+    dev = (dword >> 16) & 0xffff
+    if not any((dev & mask) in devlist for mask, devlist in devices): return []
+    return [(APLDirectPCIDevice, 'usb4:apl0')]  # 'usb4' as tinygrad's own 09-05 Mac client; nv/ip.py bdf_as_int maps 'usb*' to 0
+
+  def __init__(self, devpref:str, pcibus:str):
+    if (rc:=tgd().tgd_open()) != 0:
+      raise RuntimeError("APL_DIRECT: no 'tinygpu' service (dext not loaded or no GPU)" if rc == -1 else
+                         f"APL_DIRECT: IOServiceOpen failed {rc:#x} (dext refuses this client)")
+    self.pcibus, self.dev_id, self.peer_group, self.irq_poller = pcibus, 0, "APLDirect", None
+    self.dma_allocs:dict[int, tuple[int, int]] = {}  # ptr -> (handle, mapped size); tinygrad rarely frees sysmem
+    self.host_regs:dict[int, int] = {}  # key -> handle from tgd_dma_register for existing host memory
+
+  @functools.cache
+  def bar_info(self, bar_idx:int) -> tuple[int, int]:
+    size = ctypes.c_uint64()
+    if not (addr:=tgd().tgd_map_bar(bar_idx, 0, ctypes.byref(size))): raise RuntimeError(f"APL_DIRECT: map BAR{bar_idx} failed")
+    return addr, size.value  # like the socket path, [0] is a CPU address, not a bus address
+
+  def map_bar(self, bar:int, off:int=0, addr:int=0, size:int|None=None, fmt='B') -> MMIOInterface:
+    base, bsize = self.bar_info(bar)
+    return DirectMMIOInterface(base + off, size or (bsize - off), fmt=fmt)
+
+  def alloc_sysmem(self, size:int, vaddr:int=0, contiguous:bool=False) -> tuple[MMIOInterface, list[int]]:
+    pairs, handle = (ctypes.c_uint64 * (2 * MAX_PAIRS))(), ctypes.c_uint64()
+    if not (ptr:=tgd().tgd_dma_alloc(size, pairs, MAX_PAIRS, ctypes.byref(handle))): raise RuntimeError(f"APL_DIRECT: DMA alloc of {size:#x} failed")
+    mapped = round_up(max(size, 1), 0x4000)  # libtgd rounds the same way (16 KiB pages)
+    self.dma_allocs[ptr] = (handle.value, mapped)
+    segs = [(pairs[2*i], pairs[2*i+1]) for i in range(MAX_PAIRS) if pairs[2*i+1]]
+    # same return shape as the socket path: 4 KiB page addresses, one per page of every segment
+    return MMIOInterface(ptr, mapped, fmt='B'), [p + i for p, sz in segs for i in range(0, sz, 0x1000)][:ceildiv(size, 0x1000)]
+
+  def free_sysmem(self, view:MMIOInterface):
+    handle, mapped = self.dma_allocs.pop(view.addr)
+    if (rc:=tgd().tgd_dma_free(handle, view.addr, mapped)) != 0: raise RuntimeError(f"APL_DIRECT: DMA free of {view.addr:#x} failed {rc:#x}")
+
+  def cpu_view(self, addr:int, size:int) -> MMIOInterface: return MMIOInterface(addr, size, fmt='B')
+
+  def register_host(self, addr:int, size:int, key:int) -> list[int]:
+    # Register existing host memory: the dext maps the enclosing 16 KiB pages, tinygrad gets the 4 KiB pages of [addr, addr+size).
+    lo, hi = addr & ~0x3fff, round_up(addr + size, 0x4000)
+    pairs, handle = (ctypes.c_uint64 * (2 * MAX_PAIRS))(), ctypes.c_uint64()
+    if (rc:=tgd().tgd_dma_register(lo, hi - lo, pairs, MAX_PAIRS, ctypes.byref(handle))) != 0:
+      raise RuntimeError(f"APL_DIRECT: DMA register of {addr:#x}+{size:#x} failed {rc}")
+    self.host_regs[key] = handle.value
+    segs = [(pairs[2*i], pairs[2*i+1]) for i in range(MAX_PAIRS) if pairs[2*i+1]]
+    pages = [p + i for p, sz in segs for i in range(0, sz, 0x1000)]  # same shape as alloc_sysmem: 4 KiB page addresses
+    return pages[(addr - lo) // 0x1000:(addr - lo) // 0x1000 + ceildiv(size, 0x1000)]
+
+  def unregister_host(self, key:int):
+    if (handle:=self.host_regs.pop(key, None)) is not None:
+      if (rc:=tgd().tgd_dma_unregister(handle)) != 0: raise RuntimeError(f"APL_DIRECT: DMA unregister of {handle} failed {rc}")
+
+  def reset(self):
+    if (rc:=tgd().tgd_reset()) != 0: raise RuntimeError(f"APL_DIRECT: reset failed {rc:#x}")
+  def read_config(self, offset:int, size:int) -> int:
+    val = ctypes.c_uint32()
+    if (rc:=tgd().tgd_cfg_read(offset, size, ctypes.byref(val))) != 0: raise RuntimeError(f"APL_DIRECT: cfg read {offset:#x} failed {rc:#x}")
+    return val.value
+  def write_config(self, offset:int, value:int, size:int):
+    if (rc:=tgd().tgd_cfg_write(offset, size, value)) != 0: raise RuntimeError(f"APL_DIRECT: cfg write {offset:#x} failed {rc:#x}")
+  def resize_bar(self, bar_idx:int): pass  # the dext maps the bars it has, there is nothing to resize
