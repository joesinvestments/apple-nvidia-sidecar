+def keep_out_top(pa, lo:int) -> int:
+  # the GSP region starts at lo (relative to pa.base): the pool ends there. Returns the MiB kept out.
+  if lo >= pa.size: return 0
+  start = max(s for s in pa.blocks if s <= lo)
+  size, _, _, free = pa.blocks[start]
+  assert free and start + size == pa.size, f"VRAM {pa.base + start:#x}+{size:#x} under the GSP region at {pa.base + lo:#x} is already in use"
+  if start < lo: pa._split_block(start, size, lo - start)
+  pa._remove_block(lo, pa.size - lo)
+  return (pa.size - lo) >> 20
+
+def fmc_reserved_start(vram_size:int, boot_sz:int, radix3_sz:int) -> int:
+  # fmc_boot sizes (GspFwWprMeta, vga + frts + boot + radix3 + gsp heap + non-WPR heap + pmu reserved) plus a 32 MiB margin,
+  # rounded down to a 2 MiB boundary: a conservative lower bound of where the firmware places its region.
+  rsvd = 0x20000 + 0x100000 + boot_sz + radix3_sz + 0x8700000 + 0x220000 + 0x1820000 + (32 << 20)
+  return round_down(vram_size - rsvd, 2 << 20)
